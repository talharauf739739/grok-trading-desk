# Copy to .env and fill in. .env is gitignored; never commit it.
# This project is PAPER TRADING ONLY: there is no wallet, private key or seed phrase setting, by design.

# xAI Grok API (https://console.x.ai)
XAI_API_KEY=
XAI_MODEL=

# Hard cap on Grok calls per UTC day (default 30). Grok stops by itself at the cap,
# and also pauses if xAI reports no credits. Set to 0 to turn Grok off.
GROK_DAILY_CALL_LIMIT=

# Telegram alerts (optional). Create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
